# Materiais de referência do desafio (edital, aulas, relatórios de anos anteriores de outros
# times). Ficam apenas na máquina de cada integrante: são material de terceiros e não devem
# ser republicados. Não são necessários para reproduzir o projeto.
01_Edital_e_Regras/
02_Material_de_Aulas/
03_Exemplos_Anos_Anteriores/
04_Outros/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/
build/
dist/

# Caches de ferramentas (ruff, pytest, mypy, pre-commit)
.ruff_cache/
.pytest_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.nox/
.tox/

# Environment / secrets
.env
.env.*
*.key
*.log

# Dados brutos, intermediários e processados.
# São grandes e regeneráveis pelo código de ingestão. O que garante reprodutibilidade é o
# código que baixa + o manifesto (data/manifests/), não o arquivo commitado.
data/raw/
data/interim/
data/processed/
*.csv
!tests/fixtures/*.csv
!results/**/*.csv
*.parquet
*.zip
!tests/fixtures/*.zip

# Exceção: os MANIFESTOS são versionados. São pequenos e são a prova de qual vintage de
# cada fonte foi usado — sem eles o backtest não é auditável.
!data/manifests/
!data/manifests/**

# Contra-exceção: o manifesto por raster do CHIRPS é escrito a cada download, mas a mesma
# procedência (URL, SHA-256, bytes) já está consolidada nos dois bulks em parquet, que
# cobrem 6.395 rasters. Versionar os dois níveis enterrava as ~48 fontes distintas sob
# centenas de arquivos idênticos em forma. Regenerável; fica fora do Git.
data/manifests/chirps_final_[0-9]*.json
data/manifests/chirps_prelim_[0-9]*.json
data/manifests/chirps_monthly_final_[0-9]*.json

# Saídas geradas (regeneráveis pelo pipeline)
outputs/figures/*
outputs/tables/*
!outputs/**/.gitkeep

# A camada pública de resultados é deliberadamente versionada: contém apenas
# artefatos compactos, gráficos próprios e séries derivadas do experimento selado.
!results/
!results/**

# OS / editor
.DS_Store
.vscode/
.idea/

# Ambientes e estúdios locais de agentes — nunca são parte do artefato público
.ai/
.agents/
.claude/
.codex/
pitch_studio

# Guias locais equivalentes; ficam sincronizados na máquina, não no Git
AGENTS.md
CLAUDE.md

# Claude Code local settings (redundante com .claude/, mantido por clareza)
.claude/settings.local.json
